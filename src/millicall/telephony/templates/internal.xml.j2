<profile name="internal">
  <settings>
    <param name="sip-port" value="{{ sip_port }}"/>
    <param name="sip-ip" value="{{ internal_bind_ip if internal_bind_ip is not none else sip_ip }}"/>
    <param name="rtp-ip" value="{{ internal_bind_ip if internal_bind_ip is not none else rtp_ip }}"/>
    <param name="context" value="default"/>
    <param name="dialplan" value="XML"/>
    <param name="auth-calls" value="true"/>
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>
    <!--
      SIP多層防御: REGISTER の送信元は信頼 CIDR に限定する（apply-register-acl）。
      INVITE は apply-inbound-acl にすると ACL 通過で認証が省略され、ディレクトリ変数
      （calling_permission 等）がチャネルに載らないため使わず、auth-calls=true の
      ダイジェスト認証に任せる（issue #134）。
    -->
    <param name="apply-register-acl" value="millicall_trusted"/>
    <param name="inbound-codec-prefs" value="PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="PCMU,PCMA"/>
    <!--
      HGW（ひかり電話）は PCMU のみ対応（#136）。greedy にして内線のコーデックを
      端末側ではなく FreeSWITCH 側の優先順（PCMU 先頭）で決め、外線との
      トランスコードを通常は発生させない。
    -->
    <param name="inbound-codec-negotiation" value="greedy"/>
    <param name="rtp-timer-name" value="soft"/>
    <param name="manage-presence" value="false"/>
  </settings>
  <domains>
    <domain name="{{ internal_domain }}" alias="true" parse="true"/>
  </domains>
</profile>
