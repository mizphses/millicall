#!/usr/bin/env bash
set -euo pipefail

MILLICALL_HOME="${MILLICALL_HOME:-$HOME/millicall}"
REPO_RAW="${MILLICALL_REPO_RAW:-https://raw.githubusercontent.com/mizphses/millicall/main}"

log() { printf '\033[1;34m[millicallctl]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[millicallctl] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

[ -f "${MILLICALL_HOME}/docker-compose.yml" ] \
  || die "compose が見つかりません: ${MILLICALL_HOME}/docker-compose.yml (MILLICALL_HOME を確認)"
cd "${MILLICALL_HOME}"

dc() { docker compose "$@"; }

# .env から指定キーの値を安全に読み出す。
# - コメント行（# で始まる行）・空行を無視する
# - 値前後のシングル/ダブルクォートを除去する
# - grep/sed のみで実装（eval/source 不使用、変な文字が来ても安全）
env_val() {
  local key="$1"
  local env_file="${MILLICALL_HOME}/.env"
  if [ ! -f "${env_file}" ]; then
    return 0
  fi
  # コメントでない行から KEY=VALUE を取り出し、クォートを除去する
  grep -E "^${key}=" "${env_file}" 2>/dev/null \
    | tail -n1 \
    | sed "s/^${key}=//" \
    | sed "s/^['\"]//;s/['\"]$//"
}

# 有効化すべき compose プロファイルをカンマ区切りで出力する。
#
# ルール:
#   MILLICALL_CLOUDFLARE_TUNNEL_TOKEN が非空  → cloudflare プロファイルを強制追加
#   MILLICALL_VOICEVOX_ENABLED が true/1/yes  → voicevox プロファイルを追加
#
# 検証: 以下 4 パターンの期待値
#   トークン有 + VoiceVox=true  → "cloudflare,voicevox"
#   トークン有 + VoiceVox=false → "cloudflare"
#   トークン無 + VoiceVox=true  → "voicevox"
#   トークン無 + VoiceVox=false → ""
compose_profiles() {
  local profiles=""
  local token voicevox

  token="$(env_val MILLICALL_CLOUDFLARE_TUNNEL_TOKEN)"
  voicevox="$(env_val MILLICALL_VOICEVOX_ENABLED)"

  if [ -n "${token}" ]; then
    profiles="cloudflare"
  fi

  # true / 1 / yes を大文字小文字区別なしで許容する
  case "$(printf '%s' "${voicevox}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes)
      if [ -n "${profiles}" ]; then
        profiles="${profiles},voicevox"
      else
        profiles="voicevox"
      fi
      ;;
  esac

  printf '%s' "${profiles}"
}

# 有効プロファイルを COMPOSE_PROFILES に export し、起動内容をログに出す。
# up / down / restart / update / ps の前に呼ぶ。
apply_profiles() {
  local p
  p="$(compose_profiles)"
  export COMPOSE_PROFILES="${p}"
  if [ -n "${p}" ]; then
    # Cloudflare トークン検出時は意図的な強制起動であることを明示する
    case ",${p}," in
      *,cloudflare,*)
        log "Cloudflare Tunnel トークンを検出 → cloudflared を強制起動します"
        ;;
    esac
    log "有効プロファイル: ${p}"
  else
    log "追加プロファイルなし（cloudflared / voicevox は起動しません）"
  fi
}

# compose と .env.example を最新へ再取得する（新サービス追加・compose 変更を取り込むため）。
# .env 本体は上書きしない（初回 install のみ生成）。.env.example は更新し、新設定変数を
# 利用者が確認して .env に反映できるようにする。既存 compose は .bak に退避する。
fetch_compose() {
  log "compose / .env.example を最新へ取得中..."
  cp -f docker-compose.yml docker-compose.yml.bak 2>/dev/null || true
  curl -fsSL "${REPO_RAW}/deploy/docker-compose.prod.yml" -o docker-compose.yml \
    || die "compose の取得に失敗しました（ネットワーク/URL を確認）"
  curl -fsSL "${REPO_RAW}/.env.example" -o .env.example || true
  # .env に未設定の新変数を通知する（自動反映はしない — 運用者が要否を判断）。
  if [ -f .env ] && [ -f .env.example ]; then
    new_vars="$(comm -23 \
      <(grep -oE '^#?[[:space:]]*MILLICALL_[A-Z_]+' .env.example | sed 's/^#\?[[:space:]]*//' | sort -u) \
      <(grep -oE '^MILLICALL_[A-Z_]+' .env | sort -u) 2>/dev/null || true)"
    if [ -n "${new_vars}" ]; then
      log ".env.example に .env 未設定の変数があります（必要なら .env へ反映してください）:"
      printf '  %s\n' ${new_vars}
    fi
  fi
}

# millicallctl 自身の更新を通知する（非破壊・任意）。
# - 1 日 1 回だけリモートの millicallctl と自分を比較し、差分があれば通知する。
# - ネットワーク不通（閉域運用等）では静かに諦める。処理は絶対に止めない。
# - MILLICALL_NO_UPDATE_CHECK=1 で無効化。間隔は MILLICALL_UPDATE_CHECK_INTERVAL（秒）で調整可。
check_for_update() {
  [ "${MILLICALL_NO_UPDATE_CHECK:-0}" = "1" ] && return 0
  command -v curl >/dev/null 2>&1 || return 0

  local self
  self="$(command -v millicallctl 2>/dev/null || true)"
  [ -n "${self}" ] && [ -f "${self}" ] || return 0

  # 1 日 1 回に絞る（毎コマンドでネットワークを叩かない）。
  local interval stamp now last
  interval="${MILLICALL_UPDATE_CHECK_INTERVAL:-86400}"
  stamp="${XDG_CACHE_HOME:-$HOME/.cache}/millicall/last-update-check"
  now="$(date +%s 2>/dev/null || echo 0)"
  if [ -f "${stamp}" ]; then
    last="$(cat "${stamp}" 2>/dev/null || echo 0)"
    if [ "${now}" -gt 0 ] && [ $(( now - last )) -lt "${interval}" ]; then
      return 0
    fi
  fi
  mkdir -p "$(dirname "${stamp}")" 2>/dev/null || true
  printf '%s' "${now}" > "${stamp}" 2>/dev/null || true

  # リモート版を取得して内容を比較する（バージョン番号を持たないため cmp で差分判定）。
  local remote_file
  remote_file="$(mktemp 2>/dev/null)" || return 0
  if ! curl -fsSL --max-time 5 "${REPO_RAW}/millicallctl" -o "${remote_file}" 2>/dev/null \
     || [ ! -s "${remote_file}" ]; then
    rm -f "${remote_file}"
    return 0
  fi
  if ! cmp -s "${self}" "${remote_file}"; then
    printf '\033[1;33m[millicallctl]\033[0m 新しい millicallctl が利用可能です。`millicallctl self-update` で更新できます。\n' >&2
  fi
  rm -f "${remote_file}"
}

# ---- バックアップ暗号化 --------------------------------------------------------
# data/ には DB・secrets.json（master_key）・平文の FreeSWITCH 設定が入るため、
# バックアップは必ずパスフレーズで暗号化する（無暗号では作らない）。
# パスフレーズは MILLICALL_BACKUP_PASSPHRASE か対話入力。openssl には -pass env: で
# 渡し、コマンドライン（ps で見える）には出さない。restore と同じ引数を使うこと。
BACKUP_CIPHER_ARGS=(-aes-256-cbc -salt -pbkdf2 -iter 600000 -md sha256)
BACKUP_PASSPHRASE_MIN=12

# パスフレーズを BACKUP_PASS（非 export のシェル変数）へ読み込む。
# $1=1 のとき対話入力で確認入力を求める（backup 時）。
read_backup_passphrase() {
  local confirm="${1:-0}" again
  if [ -n "${MILLICALL_BACKUP_PASSPHRASE:-}" ]; then
    BACKUP_PASS="${MILLICALL_BACKUP_PASSPHRASE}"
  else
    [ -t 0 ] || die "MILLICALL_BACKUP_PASSPHRASE が未設定で対話入力もできません（無暗号では続行しません）"
    printf 'バックアップのパスフレーズ: ' >&2
    IFS= read -rs BACKUP_PASS
    printf '\n' >&2
    if [ "${confirm}" = "1" ]; then
      printf 'もう一度入力: ' >&2
      IFS= read -rs again
      printf '\n' >&2
      [ "${BACKUP_PASS}" = "${again}" ] || die "パスフレーズが一致しません"
    fi
  fi
  if [ "${confirm}" = "1" ] && [ "${#BACKUP_PASS}" -lt "${BACKUP_PASSPHRASE_MIN}" ]; then
    die "パスフレーズは ${BACKUP_PASSPHRASE_MIN} 文字以上にしてください"
  fi
  [ -n "${BACKUP_PASS}" ] || die "パスフレーズが空です"
}

# ファイル先頭のバイト列で形式を判定する: enc（openssl enc の "Salted__"）/ gzip / unknown
backup_format() {
  local head
  head="$(od -An -tx1 -N8 "$1" | tr -d ' \n')"
  case "${head}" in
    53616c7465645f5f*) echo enc ;;
    1f8b*) echo gzip ;;
    *) echo unknown ;;
  esac
}

do_backup() {
  command -v openssl >/dev/null 2>&1 || die "openssl が見つかりません（暗号化バックアップに必要）"
  [ -d data ] || die "data/ がありません: ${MILLICALL_HOME}/data"
  read_backup_passphrase 1
  # 成果物・一時ファイルとも所有者のみ読み書き可（0600 / ディレクトリ 0700）
  umask 077
  mkdir -p backups
  chmod 700 backups
  local ts out tmp_out members
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  out="backups/millicall-${ts}.tar.gz.enc"
  tmp_out="${out}.partial"
  members="data"
  [ -f .env ] && members="data .env"
  # shellcheck disable=SC2086 # members は固定の 1〜2 語
  if ! tar czf - ${members} \
      | BACKUP_PASS="${BACKUP_PASS}" openssl enc -e "${BACKUP_CIPHER_ARGS[@]}" \
          -pass env:BACKUP_PASS -out "${tmp_out}"; then
    rm -f "${tmp_out}"
    die "backup の作成に失敗しました"
  fi
  mv "${tmp_out}" "${out}"
  log "backup 作成（暗号化済み）: ${MILLICALL_HOME}/${out}"
  log "パスフレーズを失うと復元できません。バックアップとは別の場所に保管してください。"
}

do_restore() {
  local src="${1:-}"
  [ -n "${src}" ] || die "usage: millicallctl restore <backup ファイル>"
  [ -f "${src}" ] || die "backup ファイルが見つかりません: ${src}"
  # 稼働中の core に DB を差し替えさせない（WAL 書き込み中の差し替えで破損しうる）。
  if [ -n "$(dc ps -q 2>/dev/null || true)" ]; then
    die "稼働中のコンテナがあります。先に 'millicallctl down' を実行してください"
  fi

  umask 077
  local work fmt ts listing
  work="$(mktemp -d "${MILLICALL_HOME}/.restore.XXXXXX")"
  # shellcheck disable=SC2064 # work はここで確定させる
  trap "rm -rf '${work}'" EXIT

  fmt="$(backup_format "${src}")"
  case "${fmt}" in
    enc)
      command -v openssl >/dev/null 2>&1 || die "openssl が見つかりません（暗号化バックアップの復号に必要）"
      read_backup_passphrase 0
      BACKUP_PASS="${BACKUP_PASS}" openssl enc -d "${BACKUP_CIPHER_ARGS[@]}" \
          -pass env:BACKUP_PASS -in "${src}" -out "${work}/archive.tar.gz" 2>/dev/null \
        || die "復号に失敗しました（パスフレーズ違い、またはファイル破損）"
      ;;
    gzip)
      log "無暗号の旧形式バックアップ（tar.gz）として復元します"
      cp "${src}" "${work}/archive.tar.gz"
      ;;
    *) die "backup の形式を判別できません: ${src}" ;;
  esac

  # 展開前にメンバーを検証する: data/ と .env 以外・絶対パス・.. ・リンクは拒否。
  listing="$(tar tzf "${work}/archive.tar.gz")" || die "backup を展開できません（破損の可能性）"
  while IFS= read -r m; do
    case "${m}" in
      */../*|../*|*/..|..) die "backup に不正なパスが含まれています: ${m}" ;;
      data|data/|data/*|./data|./data/|./data/*|.env|./.env) ;;
      *) die "backup に想定外のパスが含まれています: ${m}" ;;
    esac
  done <<EOF_LIST
${listing}
EOF_LIST
  if tar tvzf "${work}/archive.tar.gz" | cut -c1 | grep -q '[lh]'; then
    die "backup にリンクが含まれています（復元しません）"
  fi
  mkdir "${work}/x"
  tar xzf "${work}/archive.tar.gz" -C "${work}/x" || die "backup の展開に失敗しました"
  [ -d "${work}/x/data" ] || die "backup に data/ が含まれていません"

  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  if [ -e data ]; then
    mv data "data.pre-restore-${ts}"
    log "既存の data/ を data.pre-restore-${ts} に退避しました"
  fi
  mv "${work}/x/data" data
  if [ -f "${work}/x/.env" ]; then
    if [ -e .env ]; then
      mv .env ".env.pre-restore-${ts}"
      log "既存の .env を .env.pre-restore-${ts} に退避しました"
    fi
    mv "${work}/x/.env" .env
    chmod 600 .env
  fi
  chmod 700 data
  if [ -f data/secrets.json ]; then
    chmod 600 data/secrets.json
  else
    log "警告: backup に data/secrets.json がありません。暗号化保存された SIP 認証情報等を復号できません"
  fi
  log "復元しました。'millicallctl up' で起動し、'millicallctl logs core' で"
  log "SIP 認証情報の鍵整合性チェックにエラーが出ていないことを確認してください。"
}

usage() {
  cat <<'EOF'
millicallctl <command>

  up               起動 (up -d)
  down             停止・削除
  restart          再起動
  update           compose 再取得 + イメージ更新 (pull + up -d)
  pull             イメージ取得のみ
  logs [service]   ログ追尾 (既定: 全サービス)
  ps               コンテナ状態
  backup           data/ と .env を暗号化して backups/ に保存 (tar.gz + openssl AES-256)
  restore <file>   backup を復元 (停止中に実行。旧 data/ は data.pre-restore-* へ退避)
  version          MILLICALL_VERSION と稼働イメージ digest
  self-update      millicallctl 自身を最新へ更新
  help             このヘルプ
EOF
}

cmd="${1:-help}"
shift || true

# 実コマンド実行前に更新を確認する（help / self-update では不要なので除外）。
case "${cmd}" in
  help|--help|-h|self-update) ;;
  *) check_for_update ;;
esac

case "${cmd}" in
  up)
    apply_profiles
    dc up -d
    ;;
  down)
    apply_profiles
    dc down
    ;;
  restart)
    apply_profiles
    dc restart
    ;;
  update)
    # 環境変数で MILLICALL_VERSION が明示されていたら .env に永続化する。
    # 一回限りの env 指定（MILLICALL_VERSION=dev millicallctl update）だけだと、
    # 以後の restart / up が .env の古いタグで起動し、新イメージで前進した
    # DB マイグレーションと食い違って core が起動不能になる（実機で発生）。
    if [ -n "${MILLICALL_VERSION:-}" ] && [ -f .env ]; then
      case "${MILLICALL_VERSION}" in
        *[!A-Za-z0-9._-]*) die "MILLICALL_VERSION に使用できない文字が含まれています: ${MILLICALL_VERSION}" ;;
      esac
      if [ "$(env_val MILLICALL_VERSION)" != "${MILLICALL_VERSION}" ]; then
        if grep -q '^MILLICALL_VERSION=' .env; then
          # sed -i は GNU/BSD で非互換のため一時ファイル経由で書き換える
          tmp_env="$(mktemp)"
          sed "s/^MILLICALL_VERSION=.*/MILLICALL_VERSION=${MILLICALL_VERSION}/" .env > "${tmp_env}"
          mv "${tmp_env}" .env
        else
          printf 'MILLICALL_VERSION=%s\n' "${MILLICALL_VERSION}" >> .env
        fi
        log "MILLICALL_VERSION=${MILLICALL_VERSION} を .env に永続化しました（以後の up/restart にも適用されます）。"
      fi
    fi
    # DB マイグレーションは core 起動時に自動実行される。更新前の backup を強く推奨。
    fetch_compose
    apply_profiles
    dc pull
    dc up -d
    log "更新完了。'millicallctl ps' と 'millicallctl logs core' で確認してください。"
    ;;
  pull)     dc pull ;;
  self-update)
    tmp="$(mktemp)"
    curl -fsSL "${REPO_RAW}/millicallctl" -o "${tmp}" || die "millicallctl の取得に失敗しました"
    chmod +x "${tmp}"
    dest="$(command -v millicallctl || echo /usr/local/bin/millicallctl)"
    if mv "${tmp}" "${dest}" 2>/dev/null; then
      log "millicallctl を更新しました: ${dest}"
    else
      sudo mv "${tmp}" "${dest}" && log "millicallctl を更新しました: ${dest}"
    fi
    ;;
  logs)     dc logs -f "$@" ;;
  ps)
    apply_profiles
    dc ps
    ;;
  backup)   do_backup ;;
  restore)  do_restore "$@" ;;
  version)
    if [ -f .env ]; then grep '^MILLICALL_VERSION=' .env || echo "MILLICALL_VERSION=(未設定 -> latest)"; fi
    dc images
    ;;
  help|--help|-h) usage ;;
  *) usage; die "unknown command: ${cmd}" ;;
esac
